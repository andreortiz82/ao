---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import ContactBar from "../components/ContactBar.astro";
import { formatBlogDate } from "../lib/blog";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, tags, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} — Andre Ortiz`} description={description} />
  </head>

  <body>
    <ContactBar hasBackButton />

    <main>
      <section
        class="cs-header px-[clamp(1.5rem,5vw,4rem)] pt-[clamp(4rem,8vw,6rem)] pb-[clamp(2rem,5vw,4rem)] border-b border-(--color-line)"
      >
        <div class="max-w-200">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-(--color-ink-3) no-underline mb-6 hover:text-(--color-ink)"
          >
            ← All posts
          </a>

          {
            tags && tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-6">
                {tags.map((tag: string) => (
                  <span class="ao-tag">{tag}</span>
                ))}
              </div>
            )
          }

          <h1 class="type-cs-title mb-4">{title}</h1>

          {
            description && (
              <p
                class="font-sans text-[clamp(1.05rem,1.8vw,1.25rem)] leading-[1.6] text-(--color-ink-2) max-w-160 mb-6"
              >
                {description}
              </p>
            )
          }

          {
            pubDate && (
              <time
                class="font-mono text-[11px] uppercase tracking-[0.08em] text-(--color-ink-3)"
                datetime={pubDate.toISOString()}
              >
                {formatBlogDate(pubDate, "long")}
              </time>
            )
          }
        </div>
      </section>

      {
        heroImage && (
          <div class="w-full cs-hero-media">
            <img
              src={heroImage}
              alt={title}
              class="w-full max-h-140 object-cover block"
            />
          </div>
        )
      }

      <article
        class="ao-md-content-container px-[clamp(1.5rem,5vw,4rem)] py-[clamp(3rem,7vw,6rem)]"
      >
        <slot />
      </article>
    </main>
  </body>
</html>

<script>
  import { initCaseStudyMotion } from "../scripts/motion";

  initCaseStudyMotion();
</script>
