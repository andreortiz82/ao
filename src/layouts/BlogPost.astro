---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { AboutKeywords } from "../components/AboutKeywords";

type Props = CollectionEntry<"blog">["data"];

const post = Astro.props;
const { title, description, pubDate, tags, heroImage } = post;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <main>
      <Header />
      <article class="flex flex-col gap-8">
        {
          heroImage && (
            <div class="rounded overflow-hidden">
              <img src={heroImage} alt={title} />
            </div>
          )
        }

        <div class="px-8 flex flex-col gap-5">
          <header class="flex flex-col">
            <span class="leading-snug text-6xl font-serif">{title}</span>
            <p class="!text-xl m-0 opacity-45">{description}</p>
            <hr />
          </header>

          <div class="ao-md-content-container">
            <slot />
          </div>
          {
            tags && (
              <div class="my-[40px]">
                <AboutKeywords tags={tags} />
              </div>
            )
          }
        </div>
      </article>
      <Footer />
    </main>
  </body>
</html>

<!-- I want to build my UI UX web portfolio using React, AstroJS, and Tailwind. The project should support blog functionality using markdown as well as some custom pages like: About Me and My Case Studies. Some, but not all, case studies would need to be password protected. 

Please help me build this project. -->
