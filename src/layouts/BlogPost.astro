---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = CollectionEntry<"blog">["data"];

const post = Astro.props;
const { title, description, pubDate, tags, heroImage } = post;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />
    <main class="max-w-6xl mx-auto px-6 py-12">

      <!-- Breadcrumb -->
      <nav class="animate-fade-up mb-8">
        <a href="/blog" class="ao-link-muted">← All posts</a>
      </nav>

      <article class="max-w-3xl">

        <!-- Tags + Date -->
        <div class="animate-fade-up-delay-1 flex flex-wrap items-center gap-3 mb-5">
          {tags && tags.map((tag: string) => (
            <span class="ao-tag">{tag}</span>
          ))}
          {pubDate && (
            <span class="text-sm text-[#6B6B64]">{formatDate(pubDate)}</span>
          )}
        </div>

        <!-- Title -->
        <h1 class="animate-fade-up-delay-1 m-0 mb-4 font-display font-normal text-[#1A1A18]" style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1;">
          {title}
        </h1>
        {description && (
          <p class="animate-fade-up-delay-2 m-0 mb-8 text-xl leading-relaxed text-[#6B6B64]">
            {description}
          </p>
        )}

        <!-- Hero image -->
        {heroImage && (
          <div class="animate-fade-up-delay-2 overflow-hidden mb-10 border border-[#E2E0DB]">
            <img src={heroImage} alt={title} class="w-full object-cover" />
          </div>
        )}

        <!-- Content -->
        <div class="animate-fade-up-delay-3 ao-md-content-container">
          <slot />
        </div>

      </article>
    </main>
    <Footer />
  </body>
</html>
