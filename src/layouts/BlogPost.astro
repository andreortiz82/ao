---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { AboutKeywords } from "../components/AboutKeywords";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, tags, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />
    <main>
      <article class="flex flex-col gap-8">
        {
          heroImage && (
            <div class="rounded overflow-hidden">
              <img src={heroImage} alt={title} />
            </div>
          )
        }

        <div class="px-8 flex flex-col gap-2">
          <header class="flex flex-col gap-2">
            <h1 class="mb-0">{title}</h1>
            <p class="text-2xl m-0 opacity-80">{description}</p>
            {
              pubDate && (
                <time class="opacity-80 ">
                  <FormattedDate date={pubDate} />
                </time>
              )
            }
          </header>
          <!-- CONTENT -->
          <slot />
          <!-- CONTENT -->
          <AboutKeywords tags={tags} />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
