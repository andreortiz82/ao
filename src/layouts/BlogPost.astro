---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = CollectionEntry<"blog">["data"];

const post = Astro.props;
const { title, description, pubDate, tags, heroImage } = post;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-background">
    <Header />
    <main class="max-w-6xl mx-auto px-6 py-12">

      <!-- Breadcrumb -->
      <nav class="animate-fade-up mb-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-1 text-sm no-underline transition-colors duration-150 hover:text-accent"
          
        >
          ← All posts
        </a>
      </nav>

      <article class="max-w-2xl">

        <!-- Tags + Date -->
        <div class="animate-fade-up-delay-1 flex flex-wrap items-center gap-3 mb-5">
          {tags && tags.map((tag: string) => (
            <span class="ao-tag">{tag}</span>
          ))}
          {pubDate && (
            <span class="text-sm" >{formatDate(pubDate)}</span>
          )}
        </div>

        <!-- Title -->
        <h1
          class="animate-fade-up-delay-1 text-4xl md:text-5xl font-serif italic leading-snug mb-4"
        >
          {title}
        </h1>
        {description && (
          <p
            class="animate-fade-up-delay-2 m-0 mb-8 text-2xl text-secondary-foreground leading-relaxed"
          >
            {description}
          </p>
        )}

        <!-- Hero image -->
        {heroImage && (
          <div class="animate-fade-up-delay-2 rounded-2xl overflow-hidden mb-10 relative" style="border: 1px solid #2E2E2E;">
            <img src={heroImage} alt={title} class="w-full object-cover" />
            <!-- Dark gradient overlay at bottom for legibility -->
            <div
              class="absolute bottom-0 left-0 right-0 h-1/3 pointer-events-none"
              style="background: linear-gradient(to top, rgba(17,17,17,0.6) 0%, transparent 100%);"
            ></div>
          </div>
        )}

        <!-- Content -->
        <div class="animate-fade-up-delay-3 ao-md-content-container">
          <slot />
        </div>

      </article>
    </main>
    <Footer />
  </body>
</html>
