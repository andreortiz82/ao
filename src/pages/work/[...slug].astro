---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const workEntries = await getCollection("work");
  return workEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, heroImage, tags } = entry.data;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} — Andre Ortiz`} description={description} />
  </head>
  <body>
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-12">

      <!-- Breadcrumb -->
      <nav class="animate-fade-up mb-8">
        <a
          href="/work"
          class="inline-flex items-center gap-1 text-sm no-underline transition-colors duration-150 text-text-secondary hover:text-accent"
        >
          ← Back to Work
        </a>
      </nav>

      <!-- Hero image -->
      {heroImage && (
        <div class="animate-fade-up-delay-1 rounded-2xl overflow-hidden mb-10 border border-border-color">
          <img
            src={heroImage}
            alt={title}
            class="w-full object-cover max-h-125"
          />
        </div>
      )}

      <!-- Title + tags -->
      <div class="animate-fade-up-delay-2 max-w-3xl mb-10">
        {tags && (
          <div class="flex flex-wrap gap-1.5 mb-4">
            {tags.map((tag: string) => (
              <span class="ao-tag">{tag}</span>
            ))}
          </div>
        )}
        <h1 class="m-0 mb-4">
          {title}
        </h1>
        <p class="m-0 text-xl leading-relaxed text-text-secondary">
          {description}
        </p>
      </div>

      <!-- Content -->
      <div class="animate-fade-up-delay-3 max-w-3xl ao-md-content-container overflow-x-auto">
        <Content />
      </div>

    </main>

    <Footer />
  </body>
</html>
