---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Tag } from "../../components/AboutKeywords";
import { Lock } from "@phosphor-icons/react";

const posts = (await getCollection("work")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header />

      <div
        class="w-[340px] m-auto my-[100px] p-[40px] rounded-md"
        id="nonProtectedContent"
      >
        <div class="">
          <div
            class="p-5 flex items-center text-base-secondary justify-center gap-2"
          >
            <Lock size={40} />
          </div>
          <input
            placeholder="Enter the password"
            id="passwordInput"
            class="mb-2 text-center px-4 py-2 w-full border rounded-md border-base-secondary"
          />
        </div>
        <div class="flex flex-col gap-3">
          <button
            class="w-full px-6 py-2 cursor-pointer rounded-md bg-base-secondary transition hover:bg-primary hover:text-tag-label-hover hover:border-primary font-semibold"
            id="loginButton"
          >
            Continue
          </button>
          <a
            class="underline w-full text-center"
            href="mailto:hello@andreortiz.com?subject=Howdy!"
            >Contact me for access
          </a>
        </div>
      </div>

      <div id="protectedContent" style="display:none;">
        <section class="grid grid-cols-3 gap-4 text-xl leading-8">
          {
            posts.map((post: any) => (
              <article class="rounded p-6 flex flex-col gap-4 transition">
                <a class="flex flex-col gap-2" href={`/work/${post.id}/`}>
                  <div>
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="rounded-lg mb-2 min-h-[100px] bg-black/10"
                      loading="lazy"
                      width="100%"
                      height="auto"
                    />
                  </div>
                  <h4 class="!m-0">{post.data.title}</h4>
                  <p class="m-0 text-zinc-500 !leading-[28px]">
                    {post.data.description}
                  </p>
                </a>
                {post.data.tags && (
                  <div class="list-none flex gap-1 flex-wrap">
                    {post.data.tags.map((tag: any) => (
                      <Tag key={tag} label={tag} size="small" />
                    ))}
                  </div>
                )}
              </article>
            ))
          }
          <!-- {
            posts.map((post: any) => (
              <article class="bg-zinc-900 rounded p-6 flex flex-col gap-2">
                <a href={`/work/${post.id}/`}>
                  <div>
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="rounded-lg mb-2"
                      loading="lazy"
                      width="100%"
                      height="auto"
                    />
                  </div>
                  <h4>{post.data.title}</h4>
                  <p class="m-0 text-zinc-500">{post.data.description}</p>
                </a>

                {post.data.tags && (
                  <div class="list-none flex gap-1 flex-wrap">
                    {post.data.tags.map((tag: any) => (
                      <Tag key={tag} label={tag} size="small" />
                    ))}
                  </div>
                )}
              </article>
            ))
          } -->
        </section>
      </div>
      <Footer />
    </main>
    <script src="../../protected.js"></script>
  </body>
</html>
