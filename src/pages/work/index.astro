---
import BaseHead from "../../components/BaseHead.astro";
import ContactBar from "../../components/ContactBar.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getWorkEntries } from "../../lib/work";

const work = await getWorkEntries();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Work — ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <ContactBar hasBackButton />

    <main class="flex flex-col">
      <div
        class="px-[clamp(1.5rem,5vw,4rem)] pt-[clamp(4rem,8vw,6rem)] pb-[clamp(2rem,5vw,3rem)] border-b border-(--color-line) max-w-200"
      >
        <span class="section-label">Work</span>
        <h1 class="type-cs-title mt-4 mb-3">Case studies</h1>
        <p class="font-sans text-[17px] leading-[1.6] text-(--color-ink-2) m-0">
          Interactive proof alongside written case studies — same order as the
          homepage grid.
        </p>
      </div>

      <WorkGrid entries={work} />
    </main>
  </body>
</html>

<script>
  import { initHomeMotion } from "../../scripts/motion";

  initHomeMotion();
</script>
