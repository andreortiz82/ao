---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Tag } from "../../components/AboutKeywords";

const posts = (await getCollection("work")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="grid grid-cols-3 gap-4 text-xl leading-8">
        {
          posts.map((post: any) => (
            <article class="bg-slate-50 rounded p-4 flex flex-col gap-2">
              <a href={`/work/${post.id}/`}>
                <h4>{post.data.title}</h4>
                <p class="m-0">{post.data.description}</p>
              </a>
              {post.data.tags && (
                <div class="list-none flex gap-1">
                  {post.data.tags.map((tag: any) => (
                    <Tag key={tag} label={tag} size="small" />
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
