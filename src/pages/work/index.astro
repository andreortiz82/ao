---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const allWork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Work — Andre Ortiz" description="Case studies and selected work from 20+ years of product design." />
  </head>
  <body style="background: #FAFAF8;">
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-20">

      <!-- Hero -->
      <div class="mb-16 max-w-2xl">
        <p class="animate-fade-up text-xs font-semibold uppercase tracking-widest text-[#6B6B64] mb-4">Selected Work</p>
        <h1
          class="animate-fade-up-delay-1 m-0 mb-6"
          style="font-family: 'Fraunces', serif; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.05; color: #1A1A18;"
        >
          Work that ships.
        </h1>
        <p class="animate-fade-up-delay-2 text-lg leading-relaxed text-[#6B6B64] m-0">
          A collection of projects spanning design systems, brand identity, and product experience. Each one built to solve a real problem with care and craft.
        </p>
      </div>

      <!-- Case study cards -->
      <div class="grid sm:grid-cols-1 md:grid-cols-3 gap-6">
        {allWork.map((item, i) => (
          <article
            class={`animate-fade-up-delay-${i + 1} group rounded-2xl overflow-hidden transition-all duration-200`}
            style="background: #FFFFFF; border: 1px solid #E8E6E1;"
            onmouseover="this.style.transform='translateY(-4px) scale(1.02)'; this.style.boxShadow='0 16px 48px rgba(0,0,0,0.10)'"
            onmouseout="this.style.transform='none'; this.style.boxShadow='none'"
          >
            <a href={`/work/${item.id}`} class="no-underline block">
              {item.data.heroImage && (
                <div class="overflow-hidden relative" style="aspect-ratio: 16/9;">
                  <img
                    src={item.data.heroImage}
                    alt={item.data.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col gap-3">
                <h2
                  class="m-0 text-xl"
                  style="font-family: 'Fraunces', serif; color: #1A1A18;"
                >
                  {item.data.title}
                </h2>
                <p class="m-0 text-sm leading-relaxed" style="color: #6B6B64;">{item.data.description}</p>
                {item.data.role && (
                  <p class="m-0 text-xs font-medium" style="color: #FF5C35;">
                    {Array.isArray(item.data.role) ? item.data.role[0] : item.data.role}
                  </p>
                )}
                {item.data.tags && (
                  <div class="flex flex-wrap gap-1.5 mt-1">
                    {item.data.tags.map((tag: string) => (
                      <span class="ao-tag">{tag}</span>
                    ))}
                  </div>
                )}
                <span class="text-sm font-semibold mt-1" style="color: #FF5C35;">View Case Study →</span>
              </div>
            </a>
          </article>
        ))}
      </div>

    </main>

    <Footer />
  </body>
</html>
