---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { Tag } from "../../components/AboutKeywords";

const posts = (await getCollection("work")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header />

      <div class="w-[340px] m-auto h-[70vh]" id="nonProtectedContent">
        <div class="pt-[100px]">
          <h5 class="mb-[20px] text-center">Enter the password.</h5>
          <input
            placeholder="Password"
            id="passwordInput"
            class="mb-2 px-4 py-2 bg-white text-black w-full border border-zinc-800"
          />
        </div>
        <div class="">
          <button
            class="w-full rounded px-6 py-2 bg-primary font-bold text-black cursor-pointer"
            id="loginButton"
          >
            Access
          </button>
        </div>
      </div>

      <div id="protectedContent" style="display:none;">
        <section class="grid grid-cols-3 gap-4 text-xl leading-8">
          {
            posts.map((post: any) => (
              <article class="rounded p-6 flex flex-col gap-4 transition">
                <a class="flex flex-col gap-2" href={`/work/${post.id}/`}>
                  <div>
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="rounded-lg mb-2 min-h-[100px] bg-black/10"
                      loading="lazy"
                      width="100%"
                      height="auto"
                    />
                  </div>
                  <h4 class="!m-0">{post.data.title}</h4>
                  <p class="m-0 text-zinc-500 !leading-[28px]">
                    {post.data.description}
                  </p>
                </a>
                {post.data.tags && (
                  <div class="list-none flex gap-1 flex-wrap">
                    {post.data.tags.map((tag: any) => (
                      <Tag key={tag} label={tag} size="small" />
                    ))}
                  </div>
                )}
              </article>
            ))
          }
          <!-- {
            posts.map((post: any) => (
              <article class="bg-zinc-900 rounded p-6 flex flex-col gap-2">
                <a href={`/work/${post.id}/`}>
                  <div>
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="rounded-lg mb-2"
                      loading="lazy"
                      width="100%"
                      height="auto"
                    />
                  </div>
                  <h4>{post.data.title}</h4>
                  <p class="m-0 text-zinc-500">{post.data.description}</p>
                </a>

                {post.data.tags && (
                  <div class="list-none flex gap-1 flex-wrap">
                    {post.data.tags.map((tag: any) => (
                      <Tag key={tag} label={tag} size="small" />
                    ))}
                  </div>
                )}
              </article>
            ))
          } -->
        </section>
      </div>
      <Footer />
    </main>
    <script src="../../protected.js"></script>
  </body>
</html>
