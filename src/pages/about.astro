---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Footer from "../components/Footer.astro";
import { AboutKeywords } from "../components/AboutKeywords";
const posts = await Astro.glob("../content/blog/*.md");
const tags = [
  ...new Set(posts.map((post) => post.frontmatter.tags).flat()),
].sort((a, b) => a.localeCompare(b));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />

      <section class="flex flex-col gap-8">
        <div class="rounded overflow-hidden">
          <img src="/family.png" alt="family" />
        </div>

        <div class="px-8 flex flex-col gap-5">
          <header class="flex flex-col gap-5">
            <h1 class="!mb-0">About Me</h1>
            <p class="!text-3xl m-0 opacity-45">
              Husband, Father, Creative, & Friend
            </p>
            <span class="bg-primary w-1/4 h-[4px]"></span>
          </header>

          <div class="ao-md-content-container">
            <p>
              <b>1. Family man</b> with <a href="/blog/music1"
                >creative hobbies</a
              > and a love for technology. I live in Austin, Texas with my wife,
              daughter, and dog. I dream of building a creative space where people
              can come together, learn, create, make noise, and share ideas.
            </p>
            <hr />
            <p>
              <b>2. Product minded design leader</b> with 20 years of building B2B,
              SaaS, and B2C solutions. A dynamic contributor that will bridge the
              gap between teams through collaboration and capability. Enthusiastic
              about the future of product experiences.
            </p>

            <hr />

            <p>
              <b>3. Currently learning AI</b> and how it can help us create better
              customer experiences. AI Agents, generative AI, automation tools, and
              conversational interfaces are the future and I'm excited to be a part
              of it. Check out <a href="/tag/AI">my thoughts</a> on the topic.
            </p>

            <hr />

            <div>
              <h2>Current Position</h2>
              <p>
                Senior Product Designer & Design Systems Lead @ <a
                  target="_blank"
                  href="http://reifyhealth.com">ReifyHealth</a
                > - Remote / Boston, MA
              </p>

              <h3>Past Positions</h3>
              <ul>
                <li>
                  Founder & Lead Design Consultant @ 100 Proof - Austin, TX
                </li>
                <li>Senior Designer @ Thinktiv - Austin, TX</li>
                <li>Design Engineer @ Ecommerce - Columbus, OH</li>
                <li>Multimedia Designer @ Mills James - Columbus, OH</li>
                <li>
                  Graphic Designer @ Moist Music (Sony) - New York City, NY
                </li>
              </ul>

              <a href="/Andre_Ortiz_Resume_2025.pdf">Download my resume</a>
            </div>

            <hr />

            <div>
              <h2>Testimonials</h2>

              <section class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                <blockquote class="!text-xl !m-0">
                  <span
                    >I've worked on several projects with Andre. I've found his
                    work to be excellent - detail oriented, creative, and
                    thoughtful. His attitude is great, his work is on time, and
                    he's dependable. I would highly recommend working with Andre
                    on a creative project.</span
                  >
                  <cite class="block">
                    — <a href="https://www.jonkolko.com/">Jon Kolko</a></cite
                  >
                </blockquote>

                <blockquote class="!text-xl !m-0">
                  <span
                    >Andre is a rock star in every way but his ego. His work is
                    world-class, he's quick, and perhaps most importantly, a
                    pleasure to work with. I recommend Andrei without
                    reservation.</span
                  >
                  <cite class="block">
                    — <a href="https://www.linkedin.com/in/patrickduncan/"
                      >Patrick Duncan</a
                    >
                  </cite>
                </blockquote>
              </section>
            </div>
          </div>
        </div>
        <div class="mb-[40px]">
          <AboutKeywords tags={tags} />
        </div>
      </section>

      <Footer />
    </main>
  </body>
</html>
