---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Footer from "../components/Footer.astro";
import { AboutKeywords } from "../components/AboutKeywords";
import { storytimeData } from "../storydata";
// Get all blog posts
const posts = await Astro.glob("../content/blog/*.md");

// Extract unique tags
const tags = [
  ...new Set(posts.map((post) => post.frontmatter.tags).flat()),
].sort((a, b) => a.localeCompare(b)); // Sort alphabetically
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="flex flex-col gap-2">
        <div>
          <section
            class="welcome-section w-full h-[140vh] bg-black text-white flex flex-col items-center justify-center"
          >
            <div class="welcome-container">
              <h1 class="font-black text-8xl welcome">Blah blah...</h1>
            </div>
            <div class="image-container">
              <img class="welcome-me" src="/me-photo-1.png" alt="me1" />
            </div>
            <div class="lazer-container">
              <span class="lazer"></span>
              <span class="lazer"></span>
              <span class="lazer"></span>
              <span class="lazer"></span>
              <span class="lazer"></span>
            </div>
          </section>
          {
            storytimeData.map((story) => (
              <section class="flex w-full h-[150vh] content-container odd:bg-zinc-900/80">
                <div class="w-[80%] m-auto flex  gap-10 content-block">
                  <div class="bg-slate-50 border flex justify-center items-center rounded image w-[760px] h-[600px] drop-shadow-md">
                    <img src={story.images[0]} alt="sketch" />
                  </div>

                  <article class="copy w-[640px] text-2xl flex flex-col gap-5">
                    <p class="text-4xl font-bold">{story.heading}</p>
                    <p class="text-2xl text-zinc-400">{story.caption}</p>

                    <div class="tags flex gap-5">
                      <a
                        href={`/tag/${story.tags[0]}`}
                        class="text-xl bg-zinc-100 text-black px-4 py-2 font-semibold rounded-full"
                      >
                        {story.tags[0]}
                      </a>
                      <a
                        href={`/tag/${story.tags[1]}`}
                        class="text-xl bg-zinc-100 text-black px-4 py-2 font-semibold rounded-full"
                      >
                        {story.tags[1]}
                      </a>
                    </div>

                    <a href={story.url} class="text-blue-500">
                      {story.action}
                    </a>
                  </article>
                </div>
              </section>
            ))
          }
          <section
            class="foo w-full h-screen bg-black text-white flex flex-col items-center justify-center"
          >
            <h1 class="font-black text-8xl thank-you">Thank you</h1>
          </section>
        </div>

        <AboutKeywords tags={tags} />
      </section>
      <Footer />
    </main>

    <script src="../storytime.ts"></script>
  </body>
</html>
