---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import style from "../styles/home.module.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="padded-content">
        <div class={style["greeting"]}>
          <span class={style["dot-animate-pulse"]}></span>
          <a href="/about#current">Currently Learning</a>
        </div>
        <h1>
          Senior Product Designer, Design Systems Lead, Front-End Developer, &
          AI Enthusiast based in Austin, TX.
        </h1>
      </section>

      <section class={style["work-section"]}>
        {
          [
            {
              name: "K Bag",
              thumbnail: "/work/kbag-thumbnail.png",
              category: "Web Design",
              link: "/work/kbag",
            },
            {
              name: "Illustrations",
              thumbnail: "/work/illustration-thumbnail.png",
              category: "Fun",
              link: "/work/illustration",
            },
          ].map((work) => {
            return (
              <a href={work.link}>
                <article class={style["work-block"]}>
                  <div class={style["work-thumbnail"]}>
                    <img src={work.thumbnail} alt={work.name} />
                  </div>
                  <div class={style["work-card"]}>
                    <p>{work.category}</p>
                    <h5>{work.name}</h5>
                  </div>
                </article>
              </a>
            );
          })
        }
      </section>
      <Footer />
    </main>
  </body>
</html>
