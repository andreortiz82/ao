---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import DesignSystemDemo from "../components/demos/DesignSystemDemo.jsx";
import MedicalSchedulingDemo from "../components/demos/MedicalSchedulingDemo.jsx";
import FinanceDemo from "../components/demos/FinanceDemo.jsx";
import AIFileDemo from "../components/demos/AIFileDemo.jsx";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
      <!-- ===== HERO ===== -->
      <section class="section-wrap grid md:grid-cols-2 gap-16 items-center">
        <!-- Avatar -->
        <div
          class="animate-fade-up flex justify-center"
          style="animation-delay: 0.2s;"
        >
          <div
            style="
            width: min(340px, 100%);
            aspect-ratio: 1;
            overflow: hidden;
          "
          >
            <img
              src="/avatar.png"
              alt="Andre Ortiz"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
            />
          </div>
        </div>

        <!-- Intro -->
        <div>
          <p
            class="section-label animate-fade-up"
            style="margin-bottom: 1.5rem; animation-delay: 0s;"
          >
            Senior Product Designer
          </p>
          <h1
            class="animate-fade-up"
            style="
              font-family: var(--font-serif);
              font-size: clamp(3rem, 9vw, 8.5rem);
              font-variation-settings: 'opsz' 144, 'wght' 350;
              line-height: 0.95;
              letter-spacing: -0.035em;
              color: var(--color-ink);
              margin: 0 0 1.75rem;
              animation-delay: 0.1s;
            "
          >
            Adaptable <em>by Design.</em>
          </h1>
          <p
            class="animate-fade-up"
            style="
              font-family: var(--font-serif);
              font-size: clamp(1.35rem, 2.2vw, 1.85rem);
              font-variation-settings: 'opsz' 32, 'wght' 350;
              line-height: 1.4;
              letter-spacing: -0.01em;
              color: var(--color-ink-2);
              margin: 0 0 2rem;
              max-width: 34ch;
              animation-delay: 0.2s;
            "
          >
            Twenty years building products end to end — shaping the vision,
            owning the systems, shipping the work.
          </p>
          <div
            class="animate-fade-up flex flex-wrap gap-3"
            style="animation-delay: 0.3s;"
          >
            <a href="#contact" class="btn-primary"
              >Get in touch <span class="arrow">→</span></a
            >
            <a href="/blog" class="btn-secondary">Read the blog</a>
          </div>
        </div>
      </section>

      <!-- ===== 01 · DESIGN SYSTEMS ===== -->
      <section class="section-wrap section-border">
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 mb-12">
          <div>
            <span class="section-label">01</span>
            <span class="section-label" style="margin-top: 0.35rem;"
              >Design Systems</span
            >
          </div>
          <div>
            <h2
              style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-variation-settings: 'opsz' 72, 'wght' 400; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-ink); margin: 0 0 1rem;"
            >
              Build once. <em>Scale everywhere.</em>
            </h2>
            <p
              style="font-family: var(--font-sans); font-size: 17px; line-height: 1.6; color: var(--color-ink-2); margin: 0; max-width: 34ch;"
            >
              A token-based architecture that lets distributed teams ship
              consistent UI at any scale — without reinventing components on
              every project.
            </p>
          </div>
        </div>
        <DesignSystemDemo client:load />
      </section>

      <!-- ===== 02 · ADVANCED SCHEDULING ===== -->
      <section class="section-wrap section-border">
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 mb-12">
          <div>
            <span class="section-label">02</span>
            <span class="section-label" style="margin-top: 0.35rem;"
              >Advanced Scheduling</span
            >
          </div>
          <div>
            <h2
              style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-variation-settings: 'opsz' 72, 'wght' 400; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-ink); margin: 0 0 1rem;"
            >
              Scheduling for organizations, <em>not individuals.</em>
            </h2>
            <p
              style="font-family: var(--font-sans); font-size: 17px; line-height: 1.6; color: var(--color-ink-2); margin: 0; max-width: 34ch;"
            >
              Availability constraints, staff capacity, status workflows, and
              conflict resolution — designed to feel inevitable rather than
              complicated.
            </p>
          </div>
        </div>
        <MedicalSchedulingDemo client:load />
      </section>

      <!-- ===== 03 · BUDGETS & INVOICING ===== -->
      <section class="section-wrap section-border">
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 mb-12">
          <div>
            <span class="section-label">03</span>
            <span class="section-label" style="margin-top: 0.35rem;"
              >Budgets &amp; Invoicing</span
            >
          </div>
          <div>
            <h2
              style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-variation-settings: 'opsz' 72, 'wght' 400; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-ink); margin: 0 0 1rem;"
            >
              Financial clarity <em>at every stage.</em>
            </h2>
            <p
              style="font-family: var(--font-sans); font-size: 17px; line-height: 1.6; color: var(--color-ink-2); margin: 0; max-width: 34ch;"
            >
              From line items to payables aging — financial interfaces that
              reduce anxiety and make high-stakes decisions feel confident.
            </p>
          </div>
        </div>
        <FinanceDemo client:load />
      </section>

      <!-- ===== 04 · AI FILE SYSTEM ===== -->
      <section class="section-wrap section-border">
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 mb-12">
          <div>
            <span class="section-label">04</span>
            <span class="section-label" style="margin-top: 0.35rem;"
              >AI File System</span
            >
          </div>
          <div>
            <h2
              style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-variation-settings: 'opsz' 72, 'wght' 400; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-ink); margin: 0 0 1rem;"
            >
              Files that <em>answer questions.</em>
            </h2>
            <p
              style="font-family: var(--font-sans); font-size: 17px; line-height: 1.6; color: var(--color-ink-2); margin: 0; max-width: 34ch;"
            >
              Document-grounded AI that lets teams ask questions about their own
              knowledge base and get cited, trustworthy answers.
            </p>
          </div>
        </div>
        <AIFileDemo client:load />
      </section>

      <!-- ===== ABOUT ===== -->
      <section class="section-wrap section-border" id="about">
        <div class="grid md:grid-cols-2 gap-16">
          <!-- Left: bio + differentiators -->
          <div>
            <div class="grid md:grid-cols-[1fr_2fr] gap-8 mb-8 items-start">
              <span class="section-label">About</span>
              <h2
                style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-variation-settings: 'opsz' 72, 'wght' 400; line-height: 1.1; letter-spacing: -0.02em; color: var(--color-ink); margin: 0;"
              >
                Twenty years of <em>product design.</em>
              </h2>
            </div>
            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              <p
                style="font-size: 17px; line-height: 1.7; color: var(--color-ink-2); margin: 0;"
              >
                I lead design the way a creative director would: fast,
                iterative, and always clear about intent. Small teams with big
                scope is where I do my best work.
              </p>
              <p
                style="font-size: 17px; line-height: 1.7; color: var(--color-ink-2); margin: 0;"
              >
                I build design practices, not just screens — the systems, the
                standards, and the mentorship that make a team compound over
                time.
              </p>
              <div
                style="display: flex; flex-direction: column; gap: 0.875rem; margin-top: 0.5rem;"
              >
                {
                  [
                    [
                      "Full-stack design fluency",
                      "From brand identity and motion to design tokens and coded prototypes.",
                    ],
                    [
                      "Engineering credibility",
                      "HTML/CSS/JS, React/TypeScript — enough to build real prototypes and contribute to frontend.",
                    ],
                    [
                      "Systems thinker",
                      "Design for reuse, consistency, and scale — not one-off screens.",
                    ],
                    [
                      "AI-native",
                      "Active LLM/AI research experience. Ahead of the curve, not catching up.",
                    ],
                  ].map(([title, body]) => (
                    <div style="display: flex; gap: 0.875rem; align-items: flex-start;">
                      <div style="width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; margin-top: 8px;" />
                      <div>
                        <div style="font-size: 14px; font-weight: 500; color: var(--color-ink); margin-bottom: 2px;">
                          {title}
                        </div>
                        <div style="font-size: 14px; color: var(--color-ink-2); line-height: 1.6;">
                          {body}
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Right: experience + skills -->
          <div style="display: flex; flex-direction: column; gap: 2.5rem;">
            <div>
              <span class="section-label" style="margin-bottom: 1.25rem;"
                >Experience</span
              >
              <div style="display: flex; flex-direction: column;">
                {
                  [
                    {
                      role: "Sr. Product Designer & Design Systems Lead",
                      company: "ReifyHealth",
                      period: "2017 – Present",
                    },
                    {
                      role: "Founder & Lead Design Consultant",
                      company: "100 Proof",
                      period: "2012 – 2017",
                    },
                    {
                      role: "Senior Designer",
                      company: "Thinktiv",
                      period: "2011 – 2012",
                    },
                    {
                      role: "Design Engineer",
                      company: "IX Web Hosting",
                      period: "2009 – 2011",
                    },
                    {
                      role: "Multimedia Designer",
                      company: "Mills James",
                      period: "2007 – 2009",
                    },
                  ].map((job) => (
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 0.875rem 0; border-bottom: 1px solid var(--color-line);">
                      <div>
                        <div style="font-size: 14px; font-weight: 500; color: var(--color-ink); line-height: 1.4;">
                          {job.role}
                        </div>
                        <div style="font-size: 13px; color: var(--color-ink-3); margin-top: 2px;">
                          {job.company}
                        </div>
                      </div>
                      <div style="font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-3); white-space: nowrap; letter-spacing: 0.06em; padding-top: 2px;">
                        {job.period}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
            <div>
              <span class="section-label" style="margin-bottom: 1rem;"
                >Skills</span
              >
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                {
                  [
                    "Product Design",
                    "Design Systems",
                    "UX Research",
                    "Design Tokens",
                    "React / TypeScript",
                    "Prototyping",
                    "AI / LLM",
                    "Motion Design",
                    "Brand & Identity",
                    "Front-End Dev",
                  ].map((skill) => <span class="ao-tag">{skill}</span>)
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== CONTACT ===== -->
      <section class="section-wrap section-border" id="contact">
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 mb-10">
          <span class="section-label">Contact</span>
          <h2
            style="
            font-family: var(--font-serif);
            font-size: clamp(2.5rem, 6vw, 5rem);
            font-variation-settings: 'opsz' 144, 'wght' 350;
            line-height: 1.0;
            letter-spacing: -0.035em;
            color: var(--color-ink);
            margin: 0;
          "
          >
            Let's work <em>together.</em>
          </h2>
        </div>
        <div class="grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16">
          <div></div>
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <p
              style="font-size: 17px; line-height: 1.7; color: var(--color-ink-2); margin: 0; max-width: 34ch;"
            >
              I take on selective design work. If you're building something
              interesting and need a senior creative who can shape the vision
              and execute it, reach out.
            </p>
            <div
              style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;"
            >
              <a href="mailto:hello@andreortiz.com" class="btn-primary">
                hello@andreortiz.com <span class="arrow">→</span>
              </a>
              <div style="display: flex; align-items: center; gap: 1rem;">
                {
                  [
                    {
                      href: "#github",
                      label: "GitHub",
                      path: "M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.341-3.369-1.341-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .269.18.579.688.481C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z",
                    },
                    {
                      href: "#linkedin",
                      label: "LinkedIn",
                      path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
                    },
                    {
                      href: "#dribbble",
                      label: "Dribbble",
                      path: "M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.384-.438 1.34 3.684 1.887 6.684 1.992 7.308 2.3-1.555 3.936-4.02 4.395-6.87zm-6.115 7.808c-.153-.9-.75-4.032-2.19-7.77l-.066.02c-5.79 2.015-7.86 6.025-8.04 6.4 1.73 1.358 3.92 2.166 6.29 2.166 1.42 0 2.77-.29 4.01-.816zm-11.62-2.073c.232-.4 3.045-5.055 8.332-6.765.135-.045.27-.084.405-.12-.26-.585-.54-1.167-.832-1.74C7.17 11.775 2.206 11.71 1.756 11.7l-.004.312c0 2.633.998 5.037 2.634 6.855zm-2.42-8.955c.46.008 4.683.026 9.477-1.248-1.698-3.018-3.53-5.558-3.8-5.928-2.868 1.35-5.01 3.99-5.676 7.176zM9.6 2.052c.282.38 2.145 2.914 3.822 6 3.645-1.365 5.19-3.44 5.373-3.702-1.81-1.61-4.19-2.586-6.795-2.586-.477 0-.945.04-1.405.105zm10.44 3.862c-.21.282-1.912 2.507-5.709 4.076.232.48.45.97.653 1.46.087.197.173.396.256.595 3.417-.43 6.82.258 7.15.332-.03-2.394-.87-4.591-2.35-6.463z",
                    },
                    {
                      href: "#youtube",
                      label: "YouTube",
                      path: "M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
                    },
                    {
                      href: "#instagram",
                      label: "Instagram",
                      path: "M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12c0 3.259.014 3.668.072 4.948.058 1.278.26 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24c3.259 0 3.668-.014 4.948-.072 1.277-.058 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.689.072-4.948 0-3.259-.014-3.667-.072-4.947-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z",
                    },
                  ].map(({ href, label, path }) => (
                    <a
                      href={href}
                      aria-label={label}
                      style="color: var(--color-ink-3); transition: color 0.15s ease; display: flex; align-items: center;"
                      onmouseover="this.style.color='var(--color-ink)'"
                      onmouseout="this.style.color='var(--color-ink-3)'"
                    >
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d={path} />
                      </svg>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .section-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(5rem, 10vw, 9rem) clamp(1.25rem, 4vw, 2.5rem);
  }
  .section-border {
    border-top: 1px solid var(--color-line);
  }
</style>
