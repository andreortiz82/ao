---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Footer from "../components/Footer.astro";
import { AboutKeywords } from "../components/AboutKeywords";
import { storytimeData } from "../storydata";
import { ArrowDown } from "@phosphor-icons/react";
// Get all blog posts
const posts = await Astro.glob("../content/blog/*.md");

// Extract unique tags
const tags = [
  ...new Set(posts.map((post) => post.frontmatter.tags).flat()),
].sort((a, b) => a.localeCompare(b)); // Sort alphabetically
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="flex flex-col">
        <section
          class="welcome-section w-full h-[70vh] flex flex-col items-center justify-start"
        >
          <div class="welcome-container grow h-full">
            <!-- <h1 class="welcome">
              Digital <span class="border-b-4 border-b-primary">Product</span> &
              Experience <span class="border-b-4 border-b-primary"
                >Designer</span
              >
            </h1> -->
            <h1 class="welcome">
              I help teams <span class="border-b-4 border-b-primary"
                >design</span
              > & <span class="border-b-4 border-b-primary">ship</span> products
            </h1>
            <span
              class="arrow text-base-secondary animate-bounce flex justify-center items-start w-full text-center my-[140px]"
              ><ArrowDown size={56} /></span
            >
          </div>
        </section>
        {
          storytimeData.map((story) => (
            <section class="rounded-md p-5 transition flex w-full mb-[10vh] content-container">
              <div class="flex gap-10 content-block ">
                <div class="flex image w-1/2">
                  <a href={story.url}>
                    <img src={story.images[0]} alt="sketch" />
                  </a>
                </div>

                <article class="copy w-1/2 flex flex-col gap-5">
                  <h2 class="!m-0">{story.heading}</h2>
                  <p class="!text-2xl opacity-50">{story.caption}</p>

                  <div class="tags flex gap-4">
                    {story.tags.map((tag) => (
                      <a
                        href={`/tag/${tag}`}
                        class="flex items-center justify-center bg-tag text-tag-label hover:text-tag-label-hover hover:bg-tag-primary hover:text-base px-4 py-2 font-semibold rounded-full text-nowrap"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>

                  <span>
                    <a href={story.url} class="text-2xl underline">
                      {story.action}
                    </a>
                  </span>
                </article>
              </div>
            </section>
          ))
        }
        <div class="welcome-keywords my-[40px]">
          <AboutKeywords tags={tags} />
        </div>
      </section>
      <Footer />
    </main>

    <script src="../storytime.ts"></script>
  </body>
</html>
