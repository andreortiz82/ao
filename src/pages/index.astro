---
import Placeholder from "../components/Placeholder.astro";
import { galleryColumns } from "../data/wireframe";
import Base from "../layouts/Base.astro";
---

<Base title="Andre Ortiz" description="Home wireframe">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center px-6 pb-16 pt-14 text-center">
    <p class="text-sm" data-load-title>Andre Ortiz</p>
    <h1 id="home-role" class="mt-4 text-4xl tracking-tight md:text-6xl">Product experience designer</h1>
  </div>
  <script>
    import gsap from "gsap";

    const lines = [
      "Product experience designer",
      "Systems thinker",
      "Problem solver",
      "Collaborator",
      "Contributor",
      "Partner",
      "Human",
    ];
    const heading = document.getElementById("home-role");
    if (heading) {
      const motion = gsap.matchMedia();
      motion.add("(prefers-reduced-motion: no-preference)", () => {
        let index = 0;
        let busy = false;
        const cycle = () => {
          if (busy) return;
          busy = true;
          const next = lines[(index + 1) % lines.length];
          gsap.to(heading, {
            opacity: 0,
            filter: "blur(8px)",
            duration: 0.32,
            ease: "power2.in",
            onComplete: () => {
              heading.textContent = next;
              index = (index + 1) % lines.length;
              gsap.fromTo(
                heading,
                { opacity: 0, filter: "blur(8px)" },
                {
                  opacity: 1,
                  filter: "blur(0px)",
                  duration: 0.45,
                  ease: "power2.out",
                  onComplete: () => {
                    gsap.set(heading, { clearProps: "filter,opacity" });
                    busy = false;
                  },
                },
              );
            },
          });
        };
        const timer = window.setInterval(cycle, 2000);
        return () => window.clearInterval(timer);
      });
    }
  </script>

  <div id="work" class="mx-auto flex w-full max-w-6xl items-start gap-3 px-6 pb-8 md:gap-4">
    {
      galleryColumns.map((column) => (
        <div class="flex min-w-0 flex-1 flex-col gap-3 md:gap-4">
          {column.map((aspect) => (
            <Placeholder href="/projects/01" media aspectRatio={aspect} />
          ))}
        </div>
      ))
    }
  </div>
</Base>
