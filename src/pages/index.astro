---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Footer from "../components/Footer.astro";
import { AboutKeywords } from "../components/AboutKeywords";
// Get all blog posts
const posts = await Astro.glob("../content/blog/*.md");

// Extract unique tags
const tags = [
  ...new Set(posts.map((post) => post.frontmatter.tags).flat()),
].sort((a, b) => a.localeCompare(b)); // Sort alphabetically
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="flex flex-col gap-2">
        <div class="flex gap-2 items-center">
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"
            ></span>
          </span>
          <a class="underline" href="/tag/AI">Currently Learning</a>
        </div>
        <h1 class="mb-8 leading-tight">
          Multidisciplinary creative based in Austin, TX. I'm passionate about
          solving complex problems and shipping products.
        </h1>

        <!-- TAGS HERE -->
        <AboutKeywords tags={tags} />
      </section>
      <Footer />
    </main>
  </body>
</html>
