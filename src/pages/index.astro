---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import _ from "lodash";

const greeting = ["Hello", "Hi", "Howdy", "Hey", "Welcome", "Heyo!"];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="w-4/5 m-auto py-8">
      <Header title={SITE_TITLE} />
      <section>
        <div class="font-normal mb-3 text-2xl opacity-50">
          {_.sample(greeting)}
        </div>
        <h1 class="font-['DM_Serif_Text'] text-7xl mb-10">
          I'm Andre Ortiz. UI/UX Design, React, and Design Systems. Based in
          Austin, Texas and working at <br /><a
            href="https://www.reifyhealth.com/"
            target="_blank">Reify Health</a
          >.
        </h1>
      </section>
      <Footer />
    </main>
  </body>
</html>
