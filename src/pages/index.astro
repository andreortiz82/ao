---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { projects } from "../data/projects";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Andre Ortiz"
      description="Product Experience Designer. Twenty years building product experiences end to end."
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero-stage" aria-label="Introduction">
        <div class="wrap">
          <p class="name">Andre Ortiz</p>
          <h1 class="rotating">Product Experience Designer</h1>
        </div>
      </section>

      <section class="projects" aria-label="Selected work">
        {
          projects.map((project) => (
            <a class="project-tile" href={project.href}>
              <span class="section-label">{project.index}</span>
              <h2>{project.title}</h2>
              <p>{project.line}</p>
              <div class="tile-stage stage-grid" aria-hidden="true" />
            </a>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  .hero-stage {
    min-height: max(22rem, calc(100dvh - 10.5rem));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
    text-align: center;
  }

  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 24px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0;
  }

  h1.rotating {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 10vw, 8rem);
    font-variation-settings:
      "opsz" 144,
      "wght" 350;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    transition: opacity 0.3s ease;
    margin: 0;
    max-width: 92vw;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  .project-tile {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-height: 22rem;
    padding: 1.15rem 1.15rem 0;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .project-tile:hover {
    border-color: rgba(0, 0, 0, 0.18);
  }

  .project-tile h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    font-variation-settings:
      "opsz" 48,
      "wght" 450;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
  }

  .project-tile p {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-2);
    margin: 0;
  }

  .tile-stage {
    flex: 1;
    min-height: 9rem;
    margin: 0.85rem -1.15rem 0;
    border-top: 1px solid var(--color-line-soft);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  @media (max-width: 860px) {
    .hero-stage {
      min-height: max(20rem, calc(100dvh - 9.5rem));
    }

    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hero-stage {
      min-height: max(18rem, calc(100dvh - 8.5rem));
      padding-top: 5.5rem;
    }

    .name {
      font-size: 16px;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .project-tile {
      min-height: 16rem;
    }
  }
</style>

<script>
  const labels = [
    "Product Experience Designer",
    "Design Systems Thinker",
    "Team Collaborator",
    "Individual Contributor",
    "Design Engineer",
    "Business Partner",
    "Creative Problem Solver",
  ];
  let i = 0;
  const el = document.querySelector(".rotating") as HTMLElement | null;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (el && !reduceMotion) {
    setInterval(() => {
      el.style.opacity = "0";
      setTimeout(() => {
        i = (i + 1) % labels.length;
        el.textContent = labels[i];
        el.style.opacity = "1";
      }, 300);
    }, 2800);
  }
</script>
