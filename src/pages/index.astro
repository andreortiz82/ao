---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import _ from "lodash";

const greeting = _.sample(["Hello", "Hi there", "Howdy", "Welcome", "Hola!", "Hey there", "What's up", "Yo", "Greetings", "Salutations", "Hey", "Hi", "Heyo", "Heyo!", "Hey there!", "Hey there", "Hey", "Hi", "Hi there", "Hello", "Hello there", "Hello there!", "Hello!", "Hi", "Hi there", "Hi there!", "Hi!", "Hey", "Hey there", "Hey there!", "Hey!", "Hey", "Hi", "Hi there", "Hello", "Hello there", "Hello there!", "Hello!", "Hi", "Hi there", "Hi there!", "Hi!", "Hey", "Hey there", "Hey there!", "Hey!", "Hey", "Hi", "Hi there", "Hello", "Hello there", "Hello there!", "Hello!", "Hi", "Hi there", "Hi there!", "Hi!", "Hey", "Hey there", "Hey there!", "Hey!", "Hey", "Hi", "Hi there", "Hello", "Hello there", "Hello there!", "Hello!", "Hi", "Hi there", "Hi there!", "Hi!", "Hey", "Hey there", "Hey there!", "Hey!", "Hey", "Hi", "Hi there", "Hello", "Hello there", "Hello there!", "Hello!", "Hi", "Hi there", "Hi there!", "Hi!", "Hey", "Hey there", "Hey there!", "Hey!", "Hey", "Hi", "Hi there", "Hello", "Hello there", "Hello there!", "Hello!", "Hi", "Hi there", "Hi there!", "Hi!", "Hey", "Hey there", "Hey there!", "Hey!"]);

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section>
        <div class="greeting">
          <span>👋</span>
          <span>{greeting}</span>
        </div>
        <h1>
          I'm Andre Ortiz - Seasoned product designer, front-end developer, and creative leader. Based in
          Austin, Texas and working with <a
            href="https://www.reifyhealth.com/"
            target="_blank">Reify Health</a
          >.
        </h1>
      </section>
      <Footer />
    </main>
  </body>
</html>
