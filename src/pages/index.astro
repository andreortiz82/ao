---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const selectedWork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 4);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Discipline labels for each work item slug
const disciplines: Record<string, string> = {
  "design-system": "Design Systems",
  "medical-scheduling": "Healthcare Product",
  "financial-product": "Financial UX",
  "ai-product": "AI-Native Design",
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="max-w-6xl mx-auto px-6">

      <!-- ===== INTRODUCTION ===== -->
      <section class="pt-20 pb-20 md:pt-32 md:pb-28 grid md:grid-cols-2 gap-12 items-start">
        <div class="animate-fade-up">
          <h1 class="m-0 font-display text-[#1A1A18]" style="font-size: clamp(3.5rem, 7vw, 5.5rem); line-height: 1.05; font-weight: 700;">
            Design.<br />Ship.<br />Profit.
          </h1>
        </div>
        <div class="animate-fade-up-delay-1 flex items-start pt-2">
          <div>
            <p class="m-0 !text-[#1A1A18] text-base leading-relaxed mb-6">
              Good design doesn't make things pretty. It makes things work — for customers, for teams, and for the bottom line. I've spent twenty years building the products and systems behind companies that grew into global platforms used by 95% of an industry.
            </p>
            <div class="flex items-center gap-6">
              <a href="/work" class="ao-link-primary">See the work →</a>
              <a href="/about" class="ao-link-secondary">About me</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== WHAT I DO ===== -->
      <section class="py-16 border-t border-[#E2E0DB]">
        <div class="animate-fade-up mb-4">
          <p class="text-xs font-medium uppercase tracking-widest text-[#6B6B64] m-0 mb-3">Selected Work</p>
          <h2 class="m-0" style="font-family: 'Fraunces', serif; font-size: clamp(1.75rem, 3vw, 2.5rem); color: #1A1A18; font-weight: 400;">
            What I Do
          </h2>
        </div>
        <p class="animate-fade-up-delay-1 text-sm text-[#6B6B64] mb-10 m-0 max-w-xl leading-relaxed">
          Twenty years of product design across systems, healthcare, finance, and AI — here's the proof.
        </p>

        <div class="grid sm:grid-cols-1 md:grid-cols-2 gap-px bg-[#E2E0DB]" style="border: 1px solid #E2E0DB;">
          {selectedWork.map((item, i) => {
            const discipline = disciplines[item.id] ?? (item.data.tags?.[0] ?? "Product Design");
            return (
              <article class={`animate-fade-up-delay-${(i % 3) + 1} group bg-[#FAFAF8]`}>
                <a href={`/work/${item.id}`} class="no-underline block h-full">
                  {item.data.heroImage && (
                    <div class="overflow-hidden" style="aspect-ratio: 16/9; border-bottom: 1px solid #E2E0DB;">
                      <img
                        src={item.data.heroImage}
                        alt={item.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="p-6 flex flex-col gap-2">
                    <span class="text-xs font-medium uppercase tracking-widest text-[#6B6B64]">{discipline}</span>
                    <h3 class="m-0 text-base font-medium leading-snug" style="font-family: 'Fraunces', serif; color: #1A1A18;">
                      {item.data.title}
                    </h3>
                    <p class="m-0 text-sm leading-relaxed" style="color: #6B6B64;">{item.data.description}</p>
                    <span class="text-sm font-medium mt-2 text-[#1A1A18] group-hover:underline inline-flex items-center gap-1">
                      Case Study →
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>

      <!-- ===== LAST 3 POSTS ===== -->
      <section class="py-16 border-t border-[#E2E0DB]">
        <div class="animate-fade-up flex items-end justify-between mb-4">
          <div>
            <p class="text-xs font-medium uppercase tracking-widest text-[#6B6B64] m-0 mb-3">Writing</p>
            <h2 class="m-0" style="font-family: 'Fraunces', serif; font-size: clamp(1.75rem, 3vw, 2.5rem); color: #1A1A18; font-weight: 400;">
              Thinking out loud.
            </h2>
          </div>
          <a href="/blog" class="text-sm text-[#6B6B64] no-underline hover:text-[#1A1A18] transition-colors hidden sm:block pb-2">
            All posts →
          </a>
        </div>
        <p class="animate-fade-up-delay-1 text-sm text-[#6B6B64] mb-10 m-0 max-w-xl leading-relaxed">
          Thoughts on design systems, AI-native workflows, and building products that hold up.
        </p>

        <div class="flex flex-col border border-[#E2E0DB]">
          {recentPosts.map((post, i) => (
            <a
              href={`/blog/${post.id}/`}
              class={`animate-fade-up-delay-${i + 1} group flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-6 py-5 no-underline transition-colors duration-150 hover:bg-[#F4F3EF] ${i > 0 ? 'border-t border-[#E2E0DB]' : ''}`}
            >
              <div class="flex flex-col gap-1.5">
                <span class="font-medium text-[#1A1A18] text-sm group-hover:underline" style="font-family: 'Fraunces', serif;">
                  {post.data.title}
                </span>
                {post.data.tags && (
                  <div class="flex flex-wrap gap-1.5">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="ao-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <span class="text-xs text-[#6B6B64] whitespace-nowrap">
                {formatDate(post.data.pubDate)}
              </span>
            </a>
          ))}
        </div>

        <div class="mt-6 sm:hidden">
          <a href="/blog" class="text-sm text-[#6B6B64] no-underline hover:text-[#1A1A18] transition-colors">
            All posts →
          </a>
        </div>
      </section>

      <!-- ===== OUTRO ===== -->
      <section class="py-24 border-t border-[#E2E0DB]">
        <div class="max-w-3xl">
          <p class="animate-fade-up text-xs font-medium uppercase tracking-widest text-[#6B6B64] m-0 mb-6">Let's Work Together</p>
          <h2
            class="animate-fade-up-delay-1 m-0 mb-8 font-display font-normal text-[#1A1A18]"
            style="font-size: clamp(2.25rem, 4.5vw, 3.75rem); line-height: 1.1;"
          >
            You need a designer<br class="hidden md:block" /> who ships.
          </h2>
          <p class="animate-fade-up-delay-2 text-base leading-relaxed text-[#6B6B64] m-0 mb-4 max-w-xl">
            Not someone who hands off a Figma file and disappears. I work end-to-end — strategy through implementation — with the technical depth to get it built right the first time.
          </p>
          <p class="animate-fade-up-delay-2 text-base leading-relaxed text-[#6B6B64] m-0 mb-10 max-w-xl">
            If you're a founder building something real, or a team that needs design infrastructure that scales — let's talk.
          </p>
          <div class="animate-fade-up-delay-3 flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <a
              href="mailto:hello@andreortiz.com"
              class="ao-link-primary text-base"
            >
              Say hello →
            </a>
            <a href="/about" class="ao-link-secondary">
              More about me
            </a>
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>
