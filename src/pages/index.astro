---
import BaseHead from "../components/BaseHead.astro";
import ContactBar from "../components/ContactBar.astro";
import WorkGrid from "../components/WorkGrid.astro";
import { HERO_DEFAULT_LABEL, HERO_NAME } from "../consts";
import { getWorkEntries } from "../lib/work";

const work = await getWorkEntries();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Andre Ortiz" description="Product Experience Design" />
  </head>
  <body>
    <ContactBar />

    <main class="flex flex-col">
      <div
        class="home-hero min-h-[70vh] flex flex-col items-center justify-center gap-2 px-6 text-center border-b border-(--color-line)"
      >
        <p class="type-name hero-name">{HERO_NAME}</p>
        <h1 class="type-hero rotating">{HERO_DEFAULT_LABEL}</h1>
      </div>

      <WorkGrid entries={work} />
    </main>
  </body>
</html>

<script>
  import { initHomeMotion } from "../scripts/motion";

  initHomeMotion();
</script>

<style>
  .home-hero {
    --hero-line-scale: 1;
    position: relative;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(120px, 20vw);
    height: 1px;
    background: var(--color-line);
    transform: translateX(-50%) scaleX(var(--hero-line-scale));
    transform-origin: center;
  }

  .rotating {
    will-change: transform, opacity;
  }

  .work-tile {
    will-change: transform, opacity;
  }
</style>
