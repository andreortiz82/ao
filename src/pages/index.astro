---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Footer from "../components/Footer.astro";
import { AboutKeywords } from "../components/AboutKeywords";
import { storytimeData } from "../storydata";
// Get all blog posts
const posts = await Astro.glob("../content/blog/*.md");

// Extract unique tags
const tags = [
  ...new Set(posts.map((post) => post.frontmatter.tags).flat()),
].sort((a, b) => a.localeCompare(b)); // Sort alphabetically
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="flex flex-col">
        <section
          class="welcome-section w-full h-[60vh] flex flex-col items-center justify-start"
        >
          <div class="welcome-container grow h-full">
            <!-- dont break word -->
            <!-- <h1 class="welcome">
              I help teams <span class="border-b-4 border-b-primary"
                >design <br />& ship</span
              > products.
            </h1> -->

            <h1 class="welcome">
              Digital <span class="border-b-4 border-b-primary">Product</span> &
              Experience <span class="border-b-4 border-b-primary"
                >Designer</span>
            </h1>
          </div>
        </section>
        {
          storytimeData.map((story) => (
            <section class="flex w-full h-[700px] mb-[10px] content-container">
              <div class="flex gap-10 content-block">
                <div class="flex image drop-shadow-md w-1/2">
                  <a href={story.url}>
                    <img src={story.images[0]} alt="sketch" />
                  </a>
                </div>

                <article class="copy w-1/2 flex flex-col gap-6">
                  <h2 class="!m-0">{story.heading}</h2>
                  <p class="!text-2xl text-white/50">{story.caption}</p>

                  <div class="tags flex gap-5">
                    {story.tags.map((tag) => (
                      <a
                        href={`/tag/${tag}`}
                        class="bg-tag text-tag-label hover:bg-tag-primary hover:text-base px-4 py-2 font-semibold rounded-full text-nowrap"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>

                  <span>
                    <a
                      href={story.url}
                      class="text-primary text-2xl hover:underline"
                    >
                      {story.action}
                    </a>
                  </span>
                </article>
              </div>
            </section>
          ))
        }
        <div class="welcome-keywords my-[40px]">
          <AboutKeywords tags={tags} />
        </div>
      </section>
      <Footer />
    </main>

    <script src="../storytime.ts"></script>
  </body>
</html>
