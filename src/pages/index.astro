---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Andre Ortiz"
      description="Senior maker-leader who designs and ships delightful product experience for founders and teams."
    />
  </head>
  <body class="theme-home">
    <Header />

    <main>
      <section class="hero-stage" aria-label="Introduction">
        <div class="wrap">
          <h1>
            Andre Ortiz is a senior maker-leader who designs and ships delightful product experience.
          </h1>
          <p class="hero-lede">
            For founders, startups, and orgs that want creative talent and
            design leadership.
          </p>
        </div>
      </section>

      <section class="work" id="work" aria-label="Selected work">
        <p class="section-label">Selected work</p>
        <div class="projects">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .hero-stage {
    min-height: max(22rem, calc(100dvh - 11.5rem));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem clamp(1.25rem, 4vw, 2.5rem) 2.25rem;
    text-align: center;
  }

  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.35rem;
    max-width: 40rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 5.4vw, 4.35rem);
    font-variation-settings:
      "opsz" 144,
      "wght" 350;
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0;
    max-width: 20ch;
  }

  .hero-lede {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.4vw, 1.125rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-ink-2);
    margin: 0;
    max-width: 28ch;
  }

  .work {
    padding: 0 clamp(1.25rem, 4vw, 2.5rem) clamp(3.5rem, 8vw, 6rem);
    max-width: 1400px;
    margin: 0 auto;
    scroll-margin-top: 6rem;
  }

  .work .section-label {
    margin: 0 0 1.25rem;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  @media (max-width: 860px) {
    .hero-stage {
      min-height: max(20rem, calc(100dvh - 9.5rem));
    }

    h1 {
      max-width: 18ch;
    }
  }

  @media (max-width: 700px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .hero-stage {
      min-height: max(18rem, calc(100dvh - 8.5rem));
      padding-top: 5.5rem;
    }
  }

</style>
