---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const style = {};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="flex flex-col gap-2">
        <div class="flex gap-2 items-center">
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-sky-500"
            ></span>
          </span>
          <a class="opacity-50" href="/about#current">Currently Learning</a>
        </div>
        <h1 class="mb-8 leading-tight">
          Senior Product Designer, Design Systems Lead, Front-End Developer, &
          AI Enthusiast based in Austin, TX.
        </h1>
      </section>

      <section class="flex flex-wrap">
        {
          [
            {
              name: "K Bag",
              thumbnail: "/work/kbag-thumbnail.png",
              category: "Design",
              link: "/work/kbag",
            },
            {
              name: "Fun",
              thumbnail: "/work/illustration-thumbnail.png",
              category: "Illustrations",
              link: "/work/illustration",
            },
          ].map((work) => {
            return (
              <a href={work.link} class="w-full md:w-1/2">
                <article class="m-2 border rounded border-zinc-300 dark:border-zinc-800">
                  <div class="p-2">
                    <img src={work.thumbnail} alt={work.name} />
                  </div>
                  <div class="p-4 pt-0">
                    <p class="opacity-50">{work.category}</p>
                    <h5>{work.name}</h5>
                  </div>
                </article>
              </a>
            );
          })
        }
      </section>
      <Footer />
    </main>
  </body>
</html>
