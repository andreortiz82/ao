---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Andre Ortiz"
      description="Product Experience Designer. Twenty years building product experiences end to end."
    />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero-stage" aria-label="Introduction">
        <div class="wrap">
          <p class="name">Andre Ortiz</p>
          <h1 class="rotating">Product Experience Designer</h1>
        </div>
      </section>

      <section class="projects" aria-label="Selected work">
        {projects.map((project) => <ProjectCard project={project} />)}
      </section>
    </main>
  </body>
</html>

<style>
  .hero-stage {
    min-height: max(22rem, calc(100dvh - 10.5rem));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
    text-align: center;
  }

  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 24px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0;
  }

  h1.rotating {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 10vw, 8rem);
    font-variation-settings:
      "opsz" 144,
      "wght" 350;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    transition: opacity 0.3s ease;
    margin: 0;
    max-width: 92vw;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem) clamp(3rem, 8vw, 5rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .hero-stage {
      min-height: max(20rem, calc(100dvh - 9.5rem));
    }

    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hero-stage {
      min-height: max(18rem, calc(100dvh - 8.5rem));
      padding-top: 5.5rem;
    }

    .name {
      font-size: 16px;
    }

    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const labels = [
    "Product Experience Designer",
    "Design Systems Thinker",
    "Team Collaborator",
    "Individual Contributor",
    "Design Engineer",
    "Business Partner",
    "Creative Problem Solver",
  ];
  let i = 0;
  const el = document.querySelector(".rotating") as HTMLElement | null;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (el && !reduceMotion) {
    setInterval(() => {
      el.style.opacity = "0";
      setTimeout(() => {
        i = (i + 1) % labels.length;
        el.textContent = labels[i];
        el.style.opacity = "1";
      }, 300);
    }, 2800);
  }
</script>
