---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import style from "../styles/home.module.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main>
      <Header title={SITE_TITLE} />
      <section class="padded-content">
        <div class={style["greeting"]}>
          <span class={style["dot-animate-pulse"]}></span>
          <a href="/about#current">Currently Learning</a>
        </div>
        <h1>
          Product Design, Front-End Development, Design Systems, & AI Enthusiast
          based in Austin, TX.
        </h1>
      </section>

      <!-- <section class={style["work-section"]}>
        {
          [
            "AO Design System",
            "Analytics Dashboard",
            "Skillaboration",
            "Illustrations & Branding",
          ].map((work) => {
            return (
              <article class={style["work-block"]}>
                <div class={style["work-card"]}>
                  <h4>{work}</h4>
                </div>
              </article>
            );
          })
        }
      </section> -->
      <Footer />
    </main>
  </body>
</html>
