---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Footer from "../components/Footer.astro";
import BioBlock from "../components/BioBlock.astro";
import NavLinks from "../components/NavLinks.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="flex justify-center items-center min-h-screen">
      <section class="flex flex-col sm:flex-row gap-5">
        <aside class="min-w-100">
          <BioBlock />
        </aside>
        <article class="flex flex-col gap-5 grow w-full">
          <p class="lead">
            I've spent 20+ years leading design at companies that needed more
            than static design artifacts - they needed a function that could
            scale. I build the teams, systems, and operating conditions that
            help product teams ship consistently.
          </p>
          <div class="flex flex-col sm:flex-row gap-5">
            <p class="min-w-1/2">
              I've built design systems used across hundreds of engineers,
              helped shape design orgs through hypergrowth, and created the
              infrastructure that lets teams stop reinventing the wheel.
            </p>
            <p class="min-w-1/2">
              The best design leaders make themselves redundant. I build trust
              across disciplines and create environments where product teams
              have the clarity and confidence to do their best work.
            </p>
          </div>

          <NavLinks />
        </article>
      </section>
    </main>
  </body>
</html>
