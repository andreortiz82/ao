---
import Adjacent from "../../components/Adjacent.astro";
import Icon from "../../components/Icon.astro";
import Placeholder from "../../components/Placeholder.astro";
import Tags from "../../components/Tags.astro";
import { cases, neighbors } from "../../data/wireframe";
import Base from "../../layouts/Base.astro";

const copy =
  "This is placeholder copy for the wireframe. It stands in for a short paragraph so the column reads as text. The sentences are fake and only show the length of the block.";

export function getStaticPaths() {
  return cases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { prev, next } = neighbors(cases, item.slug);
const timeline = [
  {
    date: "2024-03",
    label: "Mar 2024",
    text: "The brief arrived as a short note. Early sketches stayed rough while the problem was still moving.",
  },
  {
    date: "2024-06",
    label: "Jun 2024",
    text: "A clickable prototype replaced the sketches. The team used it to settle the main path.",
  },
  {
    date: "2024-09",
    label: "Sep 2024",
    text: "The layout tightened. What remained was a last pass before the work shipped.",
  },
];
---

<Base title="Project Title Here — Andre Ortiz" description="Case study wireframe" header={false}>
  <article class="flex w-full flex-col">
    <div class="mx-auto flex w-full max-w-6xl flex-col px-6 pt-14">
      <a href="/" class="mb-8 inline-flex text-black" aria-label="Back to home"><Icon name="arrow-left" size={24} /></a>
      <h1 class="max-w-4xl text-5xl tracking-tight md:text-7xl">Project Title Here</h1>
      <Tags tags={item.tags} hrefBase="/projects" />

      <div class="mt-14 flex flex-col items-start gap-10 md:flex-row">
        <div class="flex w-full flex-col gap-8 text-sm leading-relaxed md:w-56 md:shrink-0">
          <section>
            <h2>Overview</h2>
            <p class="mt-2">{copy}</p>
          </section>
          <section>
            <h2>Challenges</h2>
            <p class="mt-2">{copy}</p>
          </section>
          <ol class="wf-timeline" aria-label="Timeline">
            {
              timeline.map((entry) => (
                <li>
                  <time class="text-xs" datetime={entry.date}>
                    {entry.label}
                  </time>
                  <p class="mt-1 leading-relaxed">{entry.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="flex w-full min-w-0 flex-1 flex-col gap-4">
          <Placeholder media aspectRatio="3 / 2" />
          <Placeholder media aspectRatio="3 / 2" />
          <Placeholder media aspectRatio="3 / 2" />
        </div>
      </div>
    </div>

    <Placeholder class="mt-10 w-full" media aspectRatio="2 / 1" />

    <div class="mt-10 grid w-full grid-cols-1 items-center md:grid-cols-2">
      <Placeholder class="w-full" media aspectRatio="4 / 3" />
      <section class="w-full px-6 py-8 md:px-12">
        <h2 class="text-xl">Left Image Section</h2>
        <p class="mt-3 text-sm leading-relaxed">{copy}</p>
      </section>
    </div>

    <div class="mt-10 grid w-full grid-cols-1 items-center md:grid-cols-2">
      <section class="w-full px-6 py-8 md:px-12">
        <h2 class="text-xl">Right Image Section</h2>
        <p class="mt-3 text-sm leading-relaxed">{copy}</p>
      </section>
      <Placeholder class="w-full" media aspectRatio="4 / 3" />
    </div>

    <div class="mx-auto flex w-full max-w-6xl flex-col px-6 pb-14">
      <h2 class="mt-16 text-center text-2xl">Conclusion</h2>
      <div class="mx-auto mt-6 flex w-full max-w-3xl flex-col gap-8 text-sm leading-relaxed md:flex-row">
        <p class="md:flex-1">{copy}</p>
        <p class="md:flex-1">{copy}</p>
      </div>
      <Placeholder class="mt-8" media aspectRatio="2 / 1" />

      <Adjacent
        prevHref={`/projects/${prev.slug}`}
        nextHref={`/projects/${next.slug}`}
        prevTitle="Project Title"
        nextTitle="Project Title"
      />
    </div>
  </article>
</Base>
