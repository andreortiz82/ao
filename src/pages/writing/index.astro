---
import { posts } from "../../data/wireframe";
import Base from "../../layouts/Base.astro";
---

<Base title="Writing — Andre Ortiz" description="Writing index wireframe">
  <div class="mx-auto flex w-full max-w-6xl flex-col px-6 py-14">
    <h1 class="text-4xl tracking-tight">Writing</h1>
    <ul class="mt-10 w-full border-t border-black">
      {
        posts.map((post) => (
          <li class="border-b border-black">
            <a href={`/writing/${post.slug}`} class="flex flex-col gap-2 py-5 sm:flex-row sm:gap-6">
              <span class="text-sm sm:w-24 sm:shrink-0">Date</span>
              <span class="min-w-0 sm:flex-1">
                <span class="block">{post.label}</span>
                <span class="mt-2 block text-sm">Excerpt</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
