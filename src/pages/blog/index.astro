---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-20">
      <div class="mb-14 max-w-2xl">
        <p class="section-label mb-4">Writing</p>
        <h1 class="m-0">Thinking out loud.</h1>
      </div>

      {
        posts.length === 0 ? (
          <p class="m-0 max-w-md text-[17px] leading-relaxed text-ink-2">
            No posts yet. When something is worth writing down, it will show up
            here.
          </p>
        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post: any) => (
              <article class="group overflow-hidden flex flex-col bg-paper border border-line rounded">
                <a
                  href={`/blog/${post.id}/`}
                  class="no-underline flex flex-col h-full"
                >
                  {post.data.heroImage && (
                    <div class="overflow-hidden aspect-video">
                      <img
                        src={post.data.heroImage}
                        alt={post.data.title}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="p-6 flex flex-col gap-3 flex-1">
                    <h2 class="m-0 text-[1.35rem] leading-snug">{post.data.title}</h2>
                    {post.data.description && (
                      <p class="m-0 text-sm leading-relaxed text-ink-2">
                        {post.data.description}
                      </p>
                    )}
                    {post.data.tags && (
                      <div class="flex flex-wrap gap-1.5 mt-auto pt-3">
                        {post.data.tags.slice(0, 3).map((tag: string) => (
                          <span class="ao-tag">{tag}</span>
                        ))}
                      </div>
                    )}
                    <span class="text-xs text-ink-3 mt-1">
                      {formatDate(post.data.pubDate)}
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        )
      }
    </main>

    <Footer />
  </body>
</html>
