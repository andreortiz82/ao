---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body style="background: #FAFAF8;">
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-20">

      <!-- Header -->
      <div class="mb-14 max-w-2xl">
        <p class="animate-fade-up text-xs font-semibold uppercase tracking-widest text-[#6B6B64] mb-4">Writing</p>
        <h1
          class="animate-fade-up-delay-1 m-0"
          style="font-family: 'Fraunces', serif; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.05; color: #1A1A18;"
        >
          Thinking out loud.
        </h1>
      </div>

      <!-- Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post: any, i: number) => (
          <article
            class={`animate-fade-up-delay-${Math.min(i + 1, 4)} group rounded-2xl overflow-hidden transition-all duration-200 flex flex-col`}
            style="background: #FFFFFF; border: 1px solid #E8E6E1;"
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 16px 48px rgba(0,0,0,0.08)'"
            onmouseout="this.style.transform='none'; this.style.boxShadow='none'"
          >
            <a href={`/blog/${post.id}/`} class="no-underline flex flex-col h-full">
              {post.data.heroImage && (
                <div class="overflow-hidden" style="aspect-ratio: 16/9;">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col gap-3 flex-1">
                <h2
                  class="m-0 text-xl leading-snug"
                  style="font-family: 'Fraunces', serif; color: #1A1A18;"
                >
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="m-0 text-sm leading-relaxed line-clamp-2" style="color: #6B6B64;">
                    {post.data.description}
                  </p>
                )}
                {post.data.tags && (
                  <div class="flex flex-wrap gap-1.5 mt-auto pt-3">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="ao-tag">{tag}</span>
                    ))}
                  </div>
                )}
                <span class="text-xs text-[#6B6B64] mt-1">
                  {formatDate(post.data.pubDate)}
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

    </main>

    <Footer />
  </body>
</html>
