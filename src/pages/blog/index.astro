---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="max-w-6xl mx-auto px-6 py-20">

      <!-- Page header -->
      <div class="mb-16 max-w-2xl">
        <p class="animate-fade-up text-xs font-medium uppercase tracking-widest text-[#6B6B64] m-0 mb-3">Writing</p>
        <h1
          class="animate-fade-up-delay-1 m-0 mb-5 font-display font-normal text-[#1A1A18]"
          style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1;"
        >
          Thinking out loud.
        </h1>
        <p class="animate-fade-up-delay-2 text-base leading-relaxed text-[#6B6B64] m-0">
          Thoughts on design systems, AI-native workflows, and building products that hold up.
        </p>
      </div>

      <!-- Post listing -->
      <div class="flex flex-col border border-[#E2E0DB]">
        {posts.map((post: any, i: number) => (
          <a
            href={`/blog/${post.id}/`}
            class={`animate-fade-up-delay-${Math.min(i + 1, 4)} group flex flex-col sm:flex-row sm:items-start justify-between gap-4 px-6 py-5 no-underline transition-colors duration-150 hover:bg-[#F4F3EF] bg-[#FAFAF8] ${i > 0 ? 'border-t border-[#E2E0DB]' : ''}`}
          >
            <div class="flex flex-col gap-1.5 flex-1">
              <span class="font-medium text-[#1A1A18] text-sm font-display group-hover:underline">
                {post.data.title}
              </span>
              {post.data.description && (
                <span class="text-sm text-[#6B6B64] leading-relaxed line-clamp-2 max-w-xl">
                  {post.data.description}
                </span>
              )}
              {post.data.tags && (
                <div class="flex flex-wrap gap-1.5 mt-1">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="ao-tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <span class="text-xs text-[#6B6B64] whitespace-nowrap pt-0.5">
              {formatDate(post.data.pubDate)}
            </span>
          </a>
        ))}
      </div>

    </main>

    <Footer />
  </body>
</html>
