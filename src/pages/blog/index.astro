---
import BaseHead from "../../components/BaseHead.astro";
import BlogGrid from "../../components/BlogGrid.astro";
import ContactBar from "../../components/ContactBar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getBlogPosts } from "../../lib/blog";

const posts = await getBlogPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <ContactBar hasBackButton />

    <main class="flex flex-col">
      <div
        class="px-[clamp(1.5rem,5vw,4rem)] pt-[clamp(4rem,8vw,6rem)] pb-[clamp(2rem,5vw,3rem)] border-b border-(--color-line) max-w-200"
      >
        <span class="section-label">Writing</span>
        <h1 class="type-cs-title mt-4 mb-3">Thinking out loud.</h1>
        <p class="font-sans text-[17px] leading-[1.6] text-(--color-ink-2) m-0">
          Notes on design systems, AI product UX, and building with intent.
        </p>
      </div>

      <BlogGrid posts={posts} />
    </main>
  </body>
</html>

<script>
  import { initBlogMotion } from "../../scripts/motion";

  initBlogMotion();
</script>
