---
import BaseHead from "../../components/BaseHead.astro";
import BlogGrid from "../../components/BlogGrid.astro";
import ContactBar from "../../components/ContactBar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getBlogPosts } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const uniqueTags = [
    ...new Set(
      posts.flatMap((post) => post.data.tags ?? []).filter(Boolean),
    ),
  ];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags?.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${tag} — Blog — ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <ContactBar hasBackButton />

    <main class="flex flex-col">
      <div
        class="px-[clamp(1.5rem,5vw,4rem)] pt-[clamp(4rem,8vw,6rem)] pb-[clamp(2rem,5vw,3rem)] border-b border-(--color-line) max-w-200"
      >
        <span class="section-label">Tag</span>
        <h1 class="type-cs-title mt-4 mb-3">{tag}</h1>
        <p class="font-sans text-[17px] leading-[1.6] text-(--color-ink-2) m-0">
          {posts.length} post{posts.length === 1 ? "" : "s"} tagged &ldquo;{tag}
          &rdquo;
        </p>
      </div>

      <BlogGrid posts={posts} />
    </main>
  </body>
</html>

<script>
  import { initBlogMotion } from "../../scripts/motion";

  initBlogMotion();
</script>
