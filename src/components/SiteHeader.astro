---
import Icon from "./Icon.astro";

const path = Astro.url.pathname;

const socials = [
  { label: "GitHub", icon: "github-logo" },
  { label: "LinkedIn", icon: "linkedin-logo" },
  { label: "Dribbble", icon: "dribbble-logo" },
  { label: "YouTube", icon: "youtube-logo" },
  { label: "Instagram", icon: "instagram-logo" },
];
---

<header class="bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-4 px-6 py-5">
    <div class="flex items-center gap-4">
      <a href="/" class="wf-media block h-8 w-8 border border-black" aria-label="Home"></a>
      <ul class="flex items-center gap-3">
        {
          socials.map((social) => (
            <li>
              <a href={`#${social.label.toLowerCase()}`} aria-label={social.label} class="block text-black">
                <Icon name={social.icon} size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-3" aria-label="Primary">
      <a
        href="/writing"
        class:list={["text-sm", (path === "/writing" || path.startsWith("/writing/")) && "underline"]}
        aria-current={path === "/writing" || path.startsWith("/writing/") ? "page" : undefined}
      >
        Writing
      </a>
      <a
        href="/about"
        class:list={["text-sm", path.startsWith("/about") && "underline"]}
        aria-current={path.startsWith("/about") ? "page" : undefined}
      >
        About
      </a>
      <a href="mailto:hello@andreortiz.com" class="border border-black bg-white px-3 py-1.5 text-sm">
        hello@andreortiz.com
      </a>
    </nav>
  </div>
</header>
