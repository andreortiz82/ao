---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#E8E6E1] mt-20">
  <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="text-sm text-[#6B6B64]">
      Andre Ortiz &copy; {currentYear}
    </span>
    <div class="flex items-center gap-6">
      <a
        href="mailto:hello@andreortiz.com"
        class="text-sm text-[#6B6B64] no-underline hover:text-[#1A1A18] transition-colors duration-150"
      >
        hello@andreortiz.com
      </a>
      <a
        href="https://linkedin.com/in/andreortiz"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[#6B6B64] no-underline hover:text-[#1A1A18] transition-colors duration-150"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>
