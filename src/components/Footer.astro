---
const today = new Date();
import FooterLink from "./FooterLink.astro";
import {
  GithubLogo,
  XLogo,
  InstagramLogo,
  YoutubeLogo,
  DribbbleLogo,
  House,
} from "@phosphor-icons/react";

const linkStyle = "opacity-50 hover:opacity-100 transition";
---

<footer
  class="ao flex justify-between flex-wrap border-t border-base-secondary mt-5 pt-5 relative"
>
  <button
    title="Home"
    aria-label="Home"
    type="button"
    onclick="window.location.href='/'"
    class="absolute -top-[20px] left-1/2 bg-base p-3 inline-block cursor-pointer hover:bg-primary hover:text-base rounded-full"
  >
    <House />
  </button>
  <nav class="flex gap-4 items-center">
    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://dribbble.com/andreortiz"
    >
      <DribbbleLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://github.com/andreortiz82"
    >
      <GithubLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://x.com/andreortiz"
    >
      <XLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://www.instagram.com/andreortiz/"
    >
      <InstagramLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://www.youtube.com/channel/UCp0yFoeapfq0CoNJje5npeA"
    >
      <YoutubeLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="/Andre_Ortiz_Resume_2025.pdf"
    >
      <span class="flex items-center gap-2">
        <span class="text-xs leading-[0px]">Download my resume</span>
      </span>
    </FooterLink>
  </nav>

  <div>
    <span class="opacity-45">&copy; {today.getFullYear()} Andre Ortiz</span>
    <span class="flex gap-2 items-center">
      <span><img src="/american-flag.png" /></span>
      <span class="opacity-45">Made in the USA</span>
    </span>
  </div>
</footer>
