---
const today = new Date();
import FooterLink from "./FooterLink.astro";
import style from "../styles/footer.module.css";
import {
  GithubLogo,
  XLogo,
  LinkedinLogo,
  InstagramLogo,
  YoutubeLogo,
  DribbbleLogo,
} from "@phosphor-icons/react";
---

<footer class={style["footer"]}>
  <nav class={style["links"]}>
    <div class={style["avatar"]}>
      <img
        src="https://2.gravatar.com/avatar/879046b0eefad5903a2a0bd69911530930cf2d8985702c0bc1a54fc2404e7d15?size=50"
        alt="Andre Ortiz"
        class={style["logo"]}
      />
    </div>
    <FooterLink target="_blank" href="https://x.com/andreortiz">
      <XLogo size={24} />
    </FooterLink>
    <FooterLink target="_blank" href="https://www.instagram.com/andreortiz/">
      <InstagramLogo size={24} />
    </FooterLink>
    <FooterLink
      target="_blank"
      href="https://www.youtube.com/channel/UCp0yFoeapfq0CoNJje5npeA"
    >
      <YoutubeLogo size={24} />
    </FooterLink>

    <FooterLink target="_blank" href="https://dribbble.com/andreortiz">
      <DribbbleLogo size={24} />
    </FooterLink>

    <FooterLink target="_blank" href="https://github.com/andreortiz82">
      <GithubLogo size={24} />
    </FooterLink>
    <FooterLink target="_blank" href="https://www.linkedin.com/in/andreortiz/">
      <LinkedinLogo size={24} />
    </FooterLink>
  </nav>
  <div class={style["copyright"]}>
    &copy; {today.getFullYear()} Andre Ortiz. All rights reserved.
  </div>
</footer>
