---
const today = new Date();
import FooterLink from "./FooterLink.astro";
import {
  GithubLogo,
  XLogo,
  LinkedinLogo,
  InstagramLogo,
  YoutubeLogo,
  DribbbleLogo,
} from "@phosphor-icons/react";
// import ImageMarquee from "./ImageMarquee";

const linkStyle = "opacity-50 hover:opacity-100 transition";
---

<footer
  class="ao flex justify-between flex-wrap border-t border-base-secondary mt-5 pt-5"
>
  <nav class="flex gap-4 items-center">
    <a href="/">
      <img src="/avatar.png" alt="Andre Ortiz" class="rounded-full w-10 h-10" />
    </a>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://www.linkedin.com/in/andreortiz/"
    >
      <LinkedinLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://dribbble.com/andreortiz"
    >
      <DribbbleLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://github.com/andreortiz82"
    >
      <GithubLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://x.com/andreortiz"
    >
      <XLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://www.instagram.com/andreortiz/"
    >
      <InstagramLogo size={24} />
    </FooterLink>

    <FooterLink
      class={linkStyle}
      target="_blank"
      href="https://www.youtube.com/channel/UCp0yFoeapfq0CoNJje5npeA"
    >
      <YoutubeLogo size={24} />
    </FooterLink>
  </nav>

  <div>
    <span class="opacity-50">&copy; {today.getFullYear()} Andre Ortiz. </span>
    <span class="flex gap-2 items-center">
      <span><img src="/american-flag.png" /></span>
      <span class="opacity-50">Made in the U.S.A.</span>
    </span>
  </div>
</footer>
