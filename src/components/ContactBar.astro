---
import {
  GithubLogoIcon,
  DribbbleLogoIcon,
  InstagramLogoIcon,
  LinkedinLogoIcon,
  TwitterLogoIcon,
  YoutubeLogoIcon,
} from "@phosphor-icons/react";

// Add prop: hasBackButton: boolean

interface Props {
  hasBackButton?: boolean;
}

const { hasBackButton } = Astro.props;
---

<header class="top-0 sticky z-50 w-full py-4 bg-card/80">
  <section class="flex justify-between items-center mx-auto px-4">
    <nav class="flex gap-4 items-center" aria-label="Social links">
      {hasBackButton && <a href="/">&larr;</a>}
      <button id="avatar-btn" aria-label="About Andre">
        <img
          src="/avatar.png"
          alt="Andre Ortiz"
          class="w-10 h-10 rounded-full"
        />
      </button>
      <a
        href="https://github.com/andreortiz82"
        class="social-link"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <GithubLogoIcon size={16} weight="regular" />
      </a>
      <a
        href="https://dribbble.com/andreortiz"
        class="social-link"
        aria-label="Dribbble"
        target="_blank"
        rel="noopener noreferrer"
      >
        <DribbbleLogoIcon size={16} weight="regular" />
      </a>
      <a
        href="https://www.instagram.com/andreortiz"
        class="social-link"
        aria-label="Instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        <InstagramLogoIcon size={16} weight="regular" />
      </a>
      <a
        href="https://www.linkedin.com/in/andreortiz"
        class="social-link"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <LinkedinLogoIcon size={16} weight="regular" />
      </a>
      <a
        href="https://twitter.com/andreortiz"
        class="social-link"
        aria-label="X (Twitter)"
        target="_blank"
        rel="noopener noreferrer"
      >
        <TwitterLogoIcon size={16} weight="regular" />
      </a>
      <a
        href="https://www.youtube.com/@aomusicandmore"
        class="social-link"
        aria-label="YouTube"
        target="_blank"
        rel="noopener noreferrer"
      >
        <YoutubeLogoIcon size={16} weight="regular" />
      </a>
    </nav>

    <a
      href="mailto:hello@andreortiz.com"
      class="contact text-sm text-secondary-foreground hover:underline"
    >
      hello@andreortiz.com
    </a>
  </section>
</header>

<!-- About modal -->
<div class="modal-backdrop" id="modal-backdrop" aria-hidden="true">
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-label="About Andre Ortiz"
  >
    <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
    <div class="modal-header">
      <img src="/avatar.png" alt="Andre Ortiz" class="modal-avatar" />
      <div>
        <p class="modal-eyebrow">Andre Ortiz</p>
        <p class="modal-name">Product Experience Designer</p>
      </div>
    </div>
    <p class="modal-intro">
      Twenty years building product experiences, executing the vision, owning
      the systems, shipping the work. My design process is lean, iterative,
      always clear about intent.
    </p>
    <ul class="modal-list">
      {
        [
          [
            "Full-stack design fluency",
            "Brand identity, illustration, motion, UI, and print.",
          ],
          [
            "Engineering credibility",
            "HTML/CSS/JS, React/TypeScript, Ruby, Python, and Pull Requests.",
          ],
          [
            "Systems thinker",
            "Design systems, component libraries, and scalable processes that grow with teams.",
          ],
          [
            "Creative Leadership",
            "Mentorship, cross-functional collaboration, and building strong partnerships across teams and disciplines.",
          ],
          [
            "AI and the future...",
            "AI-powered products, chatbots, agentic workflows, prompt engineering, and custom tool development.",
          ],
        ].map(([title, body]) => (
          <li class="modal-item">
            <span class="modal-item-title">{title}</span>
            <span class="modal-item-body">{body}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 100;
  }
  .modal-backdrop.open {
    opacity: 1;
    pointer-events: all;
  }

  .modal {
    background: #111;
    color: #f5f5f5;
    border-radius: 6px;
    padding: clamp(2rem, 5vw, 3rem);
    max-width: 480px;
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transform: translateY(12px);
    transition: transform 0.25s ease;
  }
  .modal-backdrop.open .modal {
    transform: translateY(0);
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: #666;
    font-size: 14px;
    cursor: pointer;
    padding: 4px 8px;
    transition: color 0.15s ease;
    line-height: 1;
  }
  .modal-close:hover {
    color: #f5f5f5;
  }

  .modal-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .modal-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .modal-eyebrow {
    font-family: var(--font-mono);
    font-size: 16px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 0.2rem;
  }

  .modal-name {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: bold;
    color: #ccc;
  }

  .modal-intro {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: #ccc;
    padding-top: 0.5rem;
    border-top: 1px solid #222;
  }

  .modal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .modal-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .modal-item-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: #f0f0f0;
  }

  .modal-item-body {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: #777;
  }
</style>

<script>
  const backdrop = document.getElementById("modal-backdrop")!;
  const btn = document.getElementById("avatar-btn")!;
  const close = document.getElementById("modal-close")!;

  btn.addEventListener("click", () => backdrop.classList.add("open"));
  close.addEventListener("click", () => backdrop.classList.remove("open"));
  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) backdrop.classList.remove("open");
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") backdrop.classList.remove("open");
  });
</script>
