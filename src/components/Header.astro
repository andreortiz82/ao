---
import HeaderLink from "./HeaderLink.astro";
import { Logo } from "../components/Logo";
import { SITE_TITLE } from "../consts";
import { Lock } from "@phosphor-icons/react";
---

<header
  class="ao flex justify-between items-center mb-5 flex-wrap border-b border-base-secondary pb-5"
>
  <a class="" href="/">
    <div class="flex items-center gap-4">
      <Logo alt={SITE_TITLE} />
      <div class="flex flex-col">
        <span class="logo text-4xl">Andre Ortiz</span>
        <span class="text-sm opacity-45">
          Product Design, Strategy & Systems.
        </span>
      </div>
    </div>
  </a>
  <nav class="flex items-center gap-10">
    <HeaderLink class="opacity-75 hover:opacity-100 transition" href="/blog">
      Creative Ideas
    </HeaderLink>
    <HeaderLink class="opacity-75 hover:opacity-100 transition" href="/work">
      <span class="flex items-center gap-2">
        <Lock size={20} />{" "}
        Portfolio
      </span>
    </HeaderLink>
    <HeaderLink class="opacity-75 hover:opacity-100 transition" href="/about">
      About Me
    </HeaderLink>
    <HeaderLink
      class="rounded-full px-4 py-2 border-base-secondary border-2 transition hover:bg-primary hover:text-base hover:border-primary"
      href="mailto:hello@andreortiz.com?subject=Howdy!"
    >
      👋 hello@andreortiz.com
    </HeaderLink>
  </nav>
</header>
